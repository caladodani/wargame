; Engine configuration file.
config_version=5

[application]
config/name="WarGame"
config/icon="res://icon.png"
; Versão desta compilação. É o que a chapa da actualização compara com o manifesto do servidor
; (wargame.json ao lado do APK): sobe-se aqui E em export_presets.cfg quando se publica.
config/version="0.3.14"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.3", "C#", "Mobile")
config/quit_on_go_back=false

[autoload]
Game="*res://src/Presentation/Game.cs"

[display]
window/handheld/orientation=6
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]
project/assembly_name="WarGame"

[input_devices]
pointing/emulate_touch_from_mouse=true

[rendering]
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
